# 本仓库 FastAPI 读取（B 套）。复制为 backend/.env 后按本机修改。
# Xinference 进程本身的变量见仓库根 README，不要和这套混在一个进程里。

XINFERENCE_URL=http://127.0.0.1:9997
XINFERENCE_API_KEY=
ASR_MODEL=seaco-paraformer-zh
ASR_TIMEOUT_SECONDS=60
ASR_HOTWORDS_DIR=data/hotwords
ASR_REPLACEMENTS_FILE=data/replacements.yaml
ASR_POSTPROCESS_ENABLED=1
ASR_ITN_ENABLED=1
FFMPEG_PATH=D:\Users\Worker\Program\services\ffmpeg\bin\ffmpeg.exe
APP_HOST=127.0.0.1
APP_PORT=8000
