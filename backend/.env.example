# Phase 1 云端流式 ASR。复制为 backend/.env 后填写密钥。
# 密钥只放在服务端，不要写进前端。

# aliyun 或 volcengine
ASR_PROVIDER=aliyun

# 阿里云百炼 Paraformer 实时识别
DASHSCOPE_API_KEY=
ALIYUN_WORKSPACE_ID=
ALIYUN_ASR_MODEL=paraformer-realtime-v2

# 火山引擎大模型流式识别（ASR_PROVIDER=volcengine 时使用）
# 新版豆包语音控制台的 API Key，不是旧版 APP ID + Access Token
VOLC_API_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# 静音多久后把当前句定稿，毫秒。阿里云 / 火山共用，默认 2000。
ASR_END_WINDOW_MS=2000

APP_HOST=127.0.0.1
APP_PORT=8000

# 下面是旧的本机 Xinference / TTS 变量，Phase 1 演示不再读取它们。
# XINFERENCE_URL=http://127.0.0.1:9997
# ASR_MODEL=seaco-paraformer-zh
# TTS_PROFILE=A
