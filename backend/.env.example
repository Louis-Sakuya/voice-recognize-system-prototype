# Phase 1 云端流式 ASR。复制为 backend/.env 后填写密钥。
# 选一个 provider：volcengine 或 aliyun。

ASR_PROVIDER=volcengine

# 火山引擎（豆包语音）。文档：https://docs.volcengine.com/docs/6561/1354869
# 新版控制台只填 API Key：https://console.volcengine.com/speech/new/setting/apikeys
# 同一应用须开通「豆包流式语音识别模型 2.0 小时版」，否则握手 403：resource not granted。
# 1.0 小时版：volc.bigasr.sauc.duration；2.0 并发版：volc.seedasr.sauc.concurrent
VOLC_API_KEY=
# 若服务是在旧控制台开的，改填下面两项，不要只用新版 API Key：
# VOLC_APP_ID=
# VOLC_ACCESS_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 阿里云 Paraformer realtime
DASHSCOPE_API_KEY=
ALIYUN_WORKSPACE_ID=
ALIYUN_ASR_MODEL=paraformer-realtime-v2

# 停顿多久后定稿（毫秒）
ASR_END_WINDOW_MS=2000

APP_HOST=127.0.0.1
APP_PORT=8000
